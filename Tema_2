package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.hardware.TouchSensor;
import com.qualcomm.robotcore.util.ElapsedTime;

@Autonomous(name = "TemaAutonom_FSM", group = "Tema")
public class TemaAutonom_FSM extends OpMode {

    public enum State {INITIAL, DRIVE_FORWARD, LOWER_ARM, CHECK_SENSOR, GRAB_ELEMENT, DRIVE_BACKWARD, IDLE}

    State currentState = State.INITIAL;

    DcMotor leftMotor;
    DcMotor rightMotor;
    DcMotor armMotor;
    Servo clawServo;
    TouchSensor touch;

    ElapsedTime timer = new ElapsedTime();

    final int ARM_TARGET = 1440;

    @Override public void init() {
        leftMotor  = hardwareMap.get(DcMotor.class, "leftMotor");
        rightMotor = hardwareMap.get(DcMotor.class, "rightMotor");
        armMotor   = hardwareMap.get(DcMotor.class, "armMotor");
        clawServo  = hardwareMap.get(Servo.class, "clawServo");
        touch      = hardwareMap.get(TouchSensor.class, "touch");

        rightMotor.setDirection(DcMotor.Direction.REVERSE);
        armMotor.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);

        telemetry.addData("Status:", "Initializat");
        telemetry.update();
    }

    @Override public void loop() {

        switch (currentState) {

            case INITIAL:
                timer.reset();
                currentState = State.DRIVE_FORWARD;
                break;

            case DRIVE_FORWARD:
                setDrivePower(0.5);
                if (timer.seconds() >= 4.0) {
                    setDrivePower(0);
                    startLoweringArm();
                    currentState = State.LOWER_ARM;
                }
                break;

            case LOWER_ARM:
                if (!armMotor.isBusy()) {
                    currentState = State.CHECK_SENSOR;
                }
                break;

            case CHECK_SENSOR:
                if (touch.isPressed()) {
                    currentState = State.GRAB_ELEMENT;
                } else {
                    timer.reset();
                    currentState = State.DRIVE_BACKWARD;
                }
                break;

            case GRAB_ELEMENT:
                closeGripper();
                timer.reset();
                currentState = State.DRIVE_BACKWARD;
                break;

            case DRIVE_BACKWARD:
                setDrivePower(-0.5);
                if (timer.seconds() >= 6.0) {
                    setDrivePower(0);
                    currentState = State.IDLE;
                }
                break;

            case IDLE:
                setDrivePower(0);
                break;
        }

        telemetry.addData("Stare:", currentState);
        telemetry.addData("Timer:", timer.seconds());
        telemetry.addData("Senzor apasat:", touch.isPressed());
        telemetry.update();
    }

    private void setDrivePower(double p) {
        leftMotor.setPower(p);
        rightMotor.setPower(p);
    }

    private void startLoweringArm() {
        armMotor.setTargetPosition(ARM_TARGET);
        armMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        armMotor.setPower(0.6);
    }

    private void closeGripper() {
        clawServo.setPosition(0.0);
    }
}
